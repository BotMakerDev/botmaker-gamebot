<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.botmaker.gamebot</groupId>
    <artifactId>gamebot</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            The SDK this bot is built on. A property rather than a literal so that the BotMaker
            repository can build this template against the SDK it is developing
            (`mvn -Ptemplates -Dbotmaker.sdk.version=0.0.0-SNAPSHOT`); a release moves this value.
            Studio's Project ▸ Upgrade… moves it too, and keeps the property.
        -->
        <botmaker.sdk.version>1.1.14</botmaker.sdk.version>
    </properties>

    <!--
        JitPack is where every BotMaker artifact below resolves from. Central and Google are
        what everything else comes from; Google is there for the Android tooling an emulator
        target reaches.
    -->
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2/</url>
        </repository>
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>google</id>
            <url>https://dl.google.com/dl/android/maven2/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
            The BotMaker SDK: what this bot's code calls, and — the same jar wearing its other
            hat — the plugin BotMaker Studio loads to draw the palette, the pictures and the
            capture tools. Change `botmaker.sdk.version` above to move the bot to another SDK;
            nothing else here has to move with it.

            This source is written for SDK 2.0.0: `Bot.run(Gamebot::goHome, Sdk.class)`, and
            `@Param`/`@Managed` from the plugin contract, which the SDK brings. An earlier SDK does
            not compile it.
        -->
        <dependency>
            <groupId>com.github.LiQiyeDev</groupId>
            <artifactId>botmaker-sdk</artifactId>
            <version>${botmaker.sdk.version}</version>
        </dependency>

        <!--
            The SDK plugin's own needs, at `provided` scope.

            `provided` says exactly what is true: these are on the classpath while the editor
            draws the SDK's screens, and your bot links none of them at run time. They are here
            because whoever puts a plugin on a classpath supplies what that plugin needs, and
            this pom is what names the plugin. Remove them and the SDK still compiles your bot —
            it just stops loading in Studio, silently, leaving an empty palette.

            `botmaker-plugin-toolkit` is deliberately NOT one of them, since 2026-09-21. The SDK
            declares it itself, at `compile` and not `optional`, so it arrives here transitively
            at exactly the version that SDK was built against. Naming it here as well pinned it
            by Maven's nearest-wins to whatever number this file happened to say — and a toolkit
            older than the SDK's own is linked against a contract that has moved, which fails the
            whole project open with a bare class name (`com/botmaker/plugin/api/ValueContext`)
            and no mention of the version that caused it. Same rule as plugin-basics: never
            declare a plugin's own dependency beside the plugin that brings it.

            The rule is about every coordinate, not only the one that bit. `jna`, `jna-platform`
            and `jackson-databind` were declared here too until 2026-09-21, at 5.13.0 and 2.15.2
            against an SDK built on 5.14.0 and 2.17.0 — older, by nearest-wins, for the same
            reason and with the same silence. They are gone: the SDK declares all three at
            `compile`, so a bot gets exactly what its own SDK was built against, and moving to
            another SDK moves them with it. Nothing this file names is something the SDK already
            brings.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>21</version>
            <scope>provided</scope>
        </dependency>
        <!-- The Remote Pilot's HTTP + WebSocket server, and its pairing QR code. -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>6.7.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- The one entry that is not about BotMaker: what a Maven project comes with. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.9.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
